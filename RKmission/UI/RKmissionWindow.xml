<?xml version="1.0" encoding="utf-8"?>
<root>
  <View view_layout="vertical">
    <BorderView name="Mission" v_alignment="TOP" h_alignment="LEFT" max_size="Point(16000,-1)" layout_borders="Rect(5,5,5,0)">
      <View view_layout="vertical">
        <TextView value="Mali mission roller controls" layout_borders="Rect(5,5,5,5)"/>
        <View view_layout="horizontal">
          <TextView value="Rubi-Ka playfield" layout_borders="Rect(5,5,5,5)"/>
          <TextInputView name="zoneInput" max_size="Point(65,13)" min_size="Point(65,13)" layout_borders="Rect(5,5,5,5)"/>
          <TextView value="Max rolls" layout_borders="Rect(5,5,5,5)"/>
          <TextInputView name="rollsInput" max_size="Point(45,13)" min_size="Point(45,13)" layout_borders="Rect(5,5,5,5)"/>
        </View>
        <View view_layout="horizontal">
          <TextView value="Difficulty 0-255" layout_borders="Rect(5,5,5,5)"/>
          <TextInputView name="difficultyInput" max_size="Point(45,13)" min_size="Point(45,13)" layout_borders="Rect(5,5,5,5)"/>
          <Button name="startButton" label="Start rolling / run" layout_borders="Rect(5,5,5,5)"/>
          <Button name="stopButton" label="Stop" layout_borders="Rect(5,5,5,5)"/>
        </View>
        <TextView name="statusText" value="" layout_borders="Rect(5,5,5,5)"/>
      </View>
    </BorderView>
    <BorderView name="Loot" v_alignment="TOP" h_alignment="LEFT" max_size="Point(16000,-1)" layout_borders="Rect(5,5,5,0)">
      <View view_layout="vertical">
        <TextView value="Manager.Loot item selection" layout_borders="Rect(5,5,5,5)"/>
        <View view_layout="horizontal">
          <TextView value="Name or ID" layout_borders="Rect(5,5,5,5)"/>
          <TextInputView name="nameInput" max_size="Point(230,13)" min_size="Point(230,13)" layout_borders="Rect(5,5,5,5)"/>
        </View>
        <View view_layout="horizontal">
          <TextView value="Min QL" layout_borders="Rect(5,5,5,5)"/>
          <TextInputView name="minQlInput" max_size="Point(40,13)" min_size="Point(40,13)" layout_borders="Rect(5,5,5,5)"/>
          <TextView value="Max QL" layout_borders="Rect(5,5,5,5)"/>
          <TextInputView name="maxQlInput" max_size="Point(40,13)" min_size="Point(40,13)" layout_borders="Rect(5,5,5,5)"/>
          <TextView value="Quantity" layout_borders="Rect(5,5,5,5)"/>
          <TextInputView name="quantityInput" max_size="Point(40,13)" min_size="Point(40,13)" layout_borders="Rect(5,5,5,5)"/>
        </View>
        <View view_layout="horizontal">
          <CheckBox name="exactCheck" label="Exact name" layout_borders="Rect(5,5,5,5)"/>
          <CheckBox name="oneEachCheck" label="One each" layout_borders="Rect(5,5,5,5)"/>
          <Button name="addButton" label="Add item" layout_borders="Rect(5,5,5,5)"/>
        </View>
        <View view_layout="horizontal">
          <TextView value="Remove rule #" layout_borders="Rect(5,5,5,5)"/>
          <TextInputView name="removeInput" max_size="Point(40,13)" min_size="Point(40,13)" layout_borders="Rect(5,5,5,5)"/>
          <Button name="removeButton" label="Remove" layout_borders="Rect(5,5,5,5)"/>
        </View>
        <TextView name="noticeText" value="" layout_borders="Rect(5,5,5,5)"/>
        <ScrollView v_scrollbar_mode="auto" scroll_client="lootScroll" layout_borders="Rect(5,5,5,5)">
          <ScrollViewChild name="lootScroll" max_size="Point(460,125)">
            <View>
              <TextView name="lootList" value="" layout_borders="Rect(5,5,5,5)"/>
            </View>
          </ScrollViewChild>
        </ScrollView>
      </View>
    </BorderView>
  </View>
</root>
