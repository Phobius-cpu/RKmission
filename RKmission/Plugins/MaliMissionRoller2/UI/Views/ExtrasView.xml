<?xml version="1.0" standalone="yes"?>
<Root>
	<View>
		<BorderView name="Background" min_size="Point(310,0)" max_size="Point(310,-1)">
			<View view_layout="horizontal">
				<HLayoutSpacer/>
				<TextView font="BOLD" value="- EXTRAS -" feature_flags="TVF_RENDER_SHADOW" layout_borders="Rect(10,5,0,0)"/>
				<HLayoutSpacer/>
				<Button name="Dev" layout_borders="Rect(0,4,4,0)"/>
			</View>
			<View view_layout="vertical" h_alignment="CENTER" min_size="Point(200,0)" max_size="Point(200,-1)" layout_borders="Rect(2,4,2,0)">
				<View view_layout="horizontal" min_size="Point(80,15)">
					<Button name="PlayAlertSound" layout_borders="Rect(2,1,2,1)"/>
					<TextView font="SMALL" value="Play Sound on Hit" layout_borders="Rect(2,0,2,0)"/>
					<HLayoutSpacer/>
				</View>
				<View view_layout="horizontal" min_size="Point(80,15)">
					<Button name="AutoAdjustQl" layout_borders="Rect(2,1,2,1)"/>
					<TextView font="SMALL" value="Auto Adjust Lvl Slider" layout_borders="Rect(2,0,2,0)"/>
					<HLayoutSpacer/>
				</View>
				<View view_layout="horizontal"  min_size="Point(80,15)">
					<Button name="RemoveRoll" layout_borders="Rect(2,1,2,0)"/>
					<TextView font="SMALL" value="Remove Rolled Entries" layout_borders="Rect(2,0,2,0)"/>
					<HLayoutSpacer/>
				</View>
				<View view_layout="horizontal" min_size="Point(80,15)">
					<Button name="AutoAccept" layout_borders="Rect(2,1,2,0)"/>
					<TextView font="SMALL" value="Auto Accept Missions" layout_borders="Rect(2,0,2,0)"/>
					<HLayoutSpacer/>
				</View>
				<View view_layout="horizontal" min_size="Point(80,15)">
					<Button name="ShowBounds" layout_borders="Rect(2,1,2,0)"/>
					<TextView font="SMALL" value="Show Playfield Bounds" layout_borders="Rect(2,0,2,0)"/>
					<HLayoutSpacer/>
				</View>
				<VLayoutSpacer/>
			</View>
		</BorderView>
	</View>
</Root>
