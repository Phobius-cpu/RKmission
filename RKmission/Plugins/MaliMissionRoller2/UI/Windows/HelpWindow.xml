<?xml version="1.0" standalone="yes"?>
<Root>
	<View min_size="Point(590,0)">
		<BorderView name="HelpFrame" layout_borders="Rect(5,5,5,5)">
			<View view_layout="vertical">
				<View view_layout="horizontal" layout_borders="Rect(5,4,4,0)">
					<TextView value="RKMission Help" font="BOLD"/>
					<HLayoutSpacer/>
					<Button label="Close" min_size="Point(45,18)" name="Close"/>
				</View>

				<BorderView layout_borders="Rect(5,5,5,5)">
					<View view_layout="vertical">
						<TextView value="Purpose" font="BOLD"/>
						<TextView name="Purpose" min_size="Point(550,120)" max_size="Point(550,120)" feature_flags="TVF_MULTILINE"/>
					</View>
				</BorderView>

				<BorderView layout_borders="Rect(5,0,5,5)">
					<View view_layout="vertical">
						<TextView value="Commands" font="BOLD"/>

						<TextView value="MISSION CONTROL" font="BOLD" layout_borders="Rect(0,4,0,1)"/>
						<View view_layout="horizontal">
							<TextView name="MissionCommands" min_size="Point(215,100)" max_size="Point(215,100)" v_alignment="TOP" feature_flags="TVF_MULTILINE"/>
							<TextView name="MissionDescriptions" min_size="Point(325,100)" max_size="Point(325,100)" v_alignment="TOP" feature_flags="TVF_MULTILINE"/>
						</View>

						<TextView value="ROLLER / DESTINATIONS" font="BOLD" layout_borders="Rect(0,4,0,1)"/>
						<View view_layout="horizontal">
							<TextView name="RollerCommands" min_size="Point(215,74)" max_size="Point(215,74)" v_alignment="TOP" feature_flags="TVF_MULTILINE"/>
							<TextView name="RollerDescriptions" min_size="Point(325,74)" max_size="Point(325,74)" v_alignment="TOP" feature_flags="TVF_MULTILINE"/>
						</View>

						<TextView value="TRAVEL / FGRID" font="BOLD" layout_borders="Rect(0,4,0,1)"/>
						<View view_layout="horizontal">
							<TextView name="TravelCommands" min_size="Point(215,87)" max_size="Point(215,87)" v_alignment="TOP" feature_flags="TVF_MULTILINE"/>
							<TextView name="TravelDescriptions" min_size="Point(325,87)" max_size="Point(325,87)" v_alignment="TOP" feature_flags="TVF_MULTILINE"/>
						</View>

						<TextView value="WINDOWS / TOOLS" font="BOLD" layout_borders="Rect(0,4,0,1)"/>
						<View view_layout="horizontal">
							<TextView name="ToolCommands" min_size="Point(215,100)" max_size="Point(215,100)" v_alignment="TOP" feature_flags="TVF_MULTILINE"/>
							<TextView name="ToolDescriptions" min_size="Point(325,100)" max_size="Point(325,100)" v_alignment="TOP" feature_flags="TVF_MULTILINE"/>
						</View>
					</View>
				</BorderView>
			</View>
		</BorderView>
	</View>
</Root>
